{
  "openapi": "3.1.0",
  "info": {
    "title": "API Habilitar la gestión en tiempo real de Contracargos",
    "description": "Contrato de servicio para el requerimiento [HU-006].",
    "version": "1.0.0"
  },
  "paths": {
    "/reembolsoss": {
      "get": {
        "summary": "Listar reembolsoss",
        "operationId": "listarReembolsoss",
        "responses": {
          "200": {
            "description": "Listado obtenido correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReembolsosResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Crear nuevo reembolsos",
        "operationId": "crearReembolsos",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NuevoReembolsosRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Creado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReembolsosResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ErrorValidacion"
          },
          "401": {
            "$ref": "#/components/responses/ErrorAutenticacion"
          },
          "403": {
            "$ref": "#/components/responses/ErrorPermisos"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NuevoReembolsosRequest": {
        "type": "object",
        "required": [
          "codigo",
          "nombre"
        ],
        "properties": {
          "codigo": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50
          },
          "nombre": {
            "type": "string",
            "minLength": 3,
            "maxLength": 150
          }
        }
      },
      "ReembolsosResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "codigo": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "estado": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "ErrorValidacion": {
        "description": "Datos de entrada inválidos (RFC 7807)",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "ErrorAutenticacion": {
        "description": "Falta token o es inválido",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "ErrorPermisos": {
        "description": "El rol no tiene permisos para esta acción",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    }
  }
}